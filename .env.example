# ============================================================
#  RAID BOT SETTINGS  -  fill in the values after each "=" sign
#  No quotes, no spaces. Save the file when you're done.
#  Never share this file with anyone: the token is like a password.
# ============================================================

# REQUIRED. Discord Developer Portal -> your application -> Bot -> Reset Token -> Copy
DISCORD_TOKEN=

# REQUIRED. Your server's ID. In Discord: Settings -> Advanced -> turn on Developer Mode,
# then right-click your server's icon -> Copy Server ID.
GUILD_ID=

# Your timezone, used when typing raid dates. Examples:
#   America/New_York  America/Chicago  America/Denver  America/Los_Angeles
#   Europe/London  Europe/Berlin  Australia/Sydney
TIMEZONE=America/New_York

# Which class/spec list to use: retail, classic_era, season_of_discovery, tbc_classic,
# wrath_classic, cata_classic, mists_classic  or  wow_forever
WOW_VERSION=retail

# How many minutes before the raid starts the bot pings everyone who signed up
REMINDER_MINUTES=30
